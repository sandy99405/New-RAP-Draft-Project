{
  "name": "@sap/generator-fiori",
  "displayName": "SAP Fiori generator",
  "version": "1.32.0",
  "description": "Create an SAPUI5 application using SAP Fiori elements or a freestyle approach",
  "homepage": "http://www.sapfiorielements.com/",
  "main": "generators/app/index.js",
  "license": "SEE LICENSE IN LICENSE",
  "author": "SAP SE",
  "keywords": [
    "SAP",
    "fiori elements",
    "fiori generator",
    "yeoman-generator"
  ],
  "private": false,
  "generator-filter": {
    "type": "tools-suite",
    "types": [
      "tools-suite",
      "project",
      "cap-ui",
      "mta.module"
    ],
    "categories": [
      "service.center.create.project"
    ]
  },
  "scripts": {
    "clean:dist": "rimraf --glob dist generators templates *.tsbuildinfo .esbuild_tmp",
    "clean": "rimraf --glob reports test/test-output .webpack_cache generators *.tsbuildinfo .esbuild_tmp",
    "build:dev": "tsc --build ./ --pretty ",
    "build:esbuild": "cross-env NODE_OPTIONS='--max-old-space-size=3072' node esbuild.js",
    "build:esbuild:dev": "cross-env NODE_OPTIONS='--max-old-space-size=3072' node esbuild.js --dev",
    "build": "npm-run-all -l info:node clean build:esbuild build:test",
    "build:all": "npm-run-all build:dev",
    "build:fast": "yarn clean && yarn lerna run --concurrency 1 --no-bail --stream build && yarn build:dev",
    "build:test": "gulp mkdirp --dirs reports/test,test/test-output && copyfiles --flat -V test/*.css reports/test",
    "bundle": "npm-run-all build tgz:package",
    "bundle:dev": "npm-run-all -l -s build:dev build:esbuild:dev tgz:package",
    "lint": "eslint .",
    "lint:summary": "eslint .  -f summary",
    "lint:fix": "eslint --fix",
    "lint:fix:all": "eslint .  --fix",
    "lint:report": "eslint .  -f multiple ",
    "format:fix": "prettier --write --loglevel silent --ignore-path ../../../.prettierignore",
    "format:fix:all": "prettier --write '**/*.{css,scss,html,js,json,ts,tsx,yaml,yml}' '!**/{out,typings,node_modules}/**' '!**/*.{svg,png,xml}' '!resources/templates/**' --ignore-path ../../../.prettierignore",
    "test": "cross-env NODE_OPTIONS='--experimental-vm-modules' FIORI_TOOLS_DISABLE_SECURE_STORE=true jest --forceExit --ci --config=jest.config.js",
    "test:integration": "cross-env NODE_OPTIONS='--experimental-vm-modules' SAP_UX_FIORI_TOOLS_DISABLE_TELEMETRY=true FIORI_TOOLS_DISABLE_SECURE_STORE=true jest --ci --forceExit --config=jest-integration.config.js",
    "test:integration:live": "cross-env NODE_OPTIONS='--experimental-vm-modules' SAP_UX_FIORI_TOOLS_DISABLE_TELEMETRY=true FIORI_TOOLS_DISABLE_SECURE_STORE=true jest --ci --forceExit --config=jest-integration-live.config.js --maxConcurrency=4",
    "test:integration:live:local": "cross-env NODE_OPTIONS='--experimental-vm-modules' SAP_UX_FIORI_TOOLS_DISABLE_TELEMETRY=true FIORI_TOOLS_DISABLE_SECURE_STORE=true live_snapshots=true jest --forceExit --config=jest-integration-live.config.js --maxConcurrency=4",
    "test:e2e:fiori": "cross-env NODE_OPTIONS='--experimental-vm-modules' SAP_UX_FIORI_TOOLS_DISABLE_TELEMETRY=true jest --config=jest-e2e.config.js --maxConcurrency=3",
    "test:deployment": "cross-env NODE_OPTIONS='--experimental-vm-modules' SAP_UX_FIORI_TOOLS_DISABLE_TELEMETRY=true FIORI_TOOLS_DISABLE_SECURE_STORE=true jest --ci --forceExit --config=jest-deployment.config.js",
    "prepack": "rimraf --glob node_modules/@sap/*/node_modules/@*",
    "yo": "yo ./generators/app",
    "tgz:package": "npm pack",
    "madge": "madge --warning --circular --exclude \"^(templates|generators|test/integration/mock-service/expected-output|test/integration/reuse-lib/expected-output|test/test-output)\" --extensions ts ./",
    "info:node": "echo 'Node Version:' && node -v",
    "generate:test:apps": "cross-env NODE_OPTIONS='--experimental-vm-modules' jest --ci --forceExit --config=jest-no-coverage-config.js ./test/tools/generate-apps.test.ts"
  },
  "devDependencies": {
    "@sap-devx/yeoman-ui-types": "1.25.1",
    "@sap-ux/adp-flp-config-sub-generator": "1.0.46",
    "@sap-ux/annotation-converter": "0.10.22",
    "@sap-ux/deploy-config-sub-generator": "1.0.60",
    "@sap-ux/fe-fpm-writer": "1.3.14",
    "@sap-ux/feature-toggle": "1.0.5",
    "@sap-ux/fiori-app-sub-generator": "1.3.40",
    "@sap-ux/fiori-elements-writer": "3.1.40",
    "@sap-ux/fiori-freestyle-writer": "3.0.85",
    "@sap-ux/fiori-generator-shared": "1.2.8",
    "@sap-ux/flp-config-sub-generator": "1.0.52",
    "@sap-ux/generator-adp": "1.0.50",
    "@sap-ux/inquirer-common": "1.0.33",
    "@sap-ux/jest-file-matchers": "1.0.2",
    "@sap-ux/nodejs-utils": "1.0.9",
    "@sap-ux/odata-service-inquirer": "3.2.10",
    "@sap-ux/project-access": "2.1.11",
    "@sap-ux/repo-app-import-sub-generator": "1.2.42",
    "@sap-ux/store": "2.0.6",
    "@sap-ux/telemetry": "1.0.25",
    "@sap-ux/ui-service-sub-generator": "1.0.42",
    "@sap-ux/ui5-application-inquirer": "1.0.33",
    "@sap-ux/ui5-info": "1.0.6",
    "@sap-ux/ui5-library-reference-sub-generator": "1.0.34",
    "@sap-ux/ui5-library-sub-generator": "1.0.33",
    "@sap/service-provider-apis": "2.13.2",
    "@sap/ux-e2e-cli-fiori": "1.32.0",
    "@types/fs-extra": "11.0.4",
    "@types/inquirer": "8.2.6",
    "@types/yeoman-generator": "5.2.14",
    "copyfiles": "2.4.1",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "fs-extra": "11.4.0",
    "i18next": "26.3.6",
    "inquirer": "8.2.6",
    "jest-circus": "30.4.2",
    "jest-each": "30.4.1",
    "jest-extended": "7.0.0",
    "jest-html-reporter": "4.4.0",
    "jest-html-reporters": "3.1.7",
    "lodash": "4.18.1",
    "minimist": "1.2.8",
    "read-pkg-up": "7.0.1",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "yeoman-environment": "3.19.3",
    "yeoman-generator": "5.10.0",
    "yeoman-test": "6.3.0",
    "yo": "5.1.0"
  },
  "optionalDependencies": {
    "@zowe/secrets-for-zowe-sdk": "8.32.0"
  },
  "files": [
    "generators",
    "templates",
    "yeoman.png",
    "adp-gen.png",
    "CHANGELOG.md"
  ],
  "additional_generators": [
    {
      "namespace": "@sap/fiori:adp",
      "displayName": "SAPUI5 Adaptation Project",
      "description": "Adaptation project allows you to create an app variant for an existing SAP Fiori elements-based or SAPUI5 freestyle application, without changing the original application.",
      "homepage": "https://help.sap.com/viewer/584e0bcbfd4a4aff91c815cefa0bce2d/Cloud/en-US/ada9567b767941aba8d49fdb4fdedea7.html",
      "image": "adp-gen.png"
    }
  ],
  "eslint-formatter-multiple": {
    "formatters": [
      {
        "name": "stylish",
        "output": "console"
      },
      {
        "name": "json",
        "output": "file",
        "path": "reports/lint/eslint.json"
      },
      {
        "name": "checkstyle",
        "output": "file",
        "path": "reports/lint/eslint.checkstyle.xml"
      }
    ]
  }
}
